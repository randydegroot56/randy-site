[project]
name = "{{ project_name_kebab }}"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
    "click>=8.1",
{% for dep in technical.dependencies %}    "{{ dep }}",
{% endfor %}]

[project.scripts]
{{ project_name_kebab }} = "{{ project_name_snake }}.cli:cli"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
testpaths = ["tests"]
